    "total_batch_size": 1024,
    "total_tokens": 20480,
    "warmup_steps": 5,
    "eval_every": 10,
    "eval_tokens": 2048,
    "save_every": 100,
    "log_every": 5
  },
  "draft_train": {
    "seq_len": 128,
    "device_batch_size": 4,
    "total_batch_size": 1024,
    "total_tokens": 10240,
    "warmup_steps": 5,
    "eval_every": 10,
    "eval_tokens": 2048,
    "save_every": 100,
    "log_every": 5,
    "draft_steps": 7,
    "step_loss_weighting": "decay",
    "step_loss_decay": 0.8,
    "lr": 3e-4
  }
}