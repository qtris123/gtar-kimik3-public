{
  "arch": "kimi_k3",
  "model": {
    "hidden_size": 128,
    "intermediate_size": 352,
    "num_hidden_layers": 4,
    "num_attention_heads": 4,
    "num_key_value_heads": 2,
    "head_dim": 32,
    "kda_num_heads": 2,
    "kda_head_dim": 64,
    "mtp_enabled": true,
    "mtp_loss_weight": 0.3,
    "feature_layer_indices": [
      0,
      1,
      3
    ]
  },
  "train": {
    "seq_len": 128,
